{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://opendrivevla.local/carla/acceptance/latency_record.schema.json",
  "title": "latency_record",
  "description": "Per-decision-cycle latency measurement.",
  "type": "object",
  "required": ["frame_id", "scenario_id", "seed", "group",
               "t_sensor_ready", "t_inference_start",
               "t_inference_end", "t_control_start", "t_apply",
               "latency_total_ms", "latency_inference_ms",
               "latency_control_ms", "deadline_ms",
               "deadline_miss"],
  "properties": {
    "frame_id": {"type": "integer", "minimum": 0},
    "scenario_id": {"type": "string"},
    "seed": {"type": "integer"},
    "group": {"enum": ["G1", "G2", "G3"]},
    "t_sensor_ready": {"type": "number",
                       "description": "epoch seconds: camera batch ready in CARLA"},
    "t_inference_start": {"type": "number",
                         "description": "epoch seconds: model.generate() invoked"},
    "t_inference_end": {"type": "number",
                       "description": "epoch seconds: model.generate() returned"},
    "t_control_start": {"type": "number",
                        "description": "epoch seconds: controller.step() invoked"},
    "t_apply": {"type": "number",
                "description": "epoch seconds: control applied to ego"},
    "latency_total_ms": {"type": "number", "minimum": 0.0,
                         "description": "(t_apply - t_sensor_ready) * 1000"},
    "latency_inference_ms": {"type": "number", "minimum": 0.0,
                             "description": "(t_inference_end - t_inference_start) * 1000"},
    "latency_control_ms": {"type": "number", "minimum": 0.0,
                           "description": "(t_apply - t_control_start) * 1000"},
    "deadline_ms": {"type": "number", "minimum": 0.0,
                    "description": "150 ms (acceptance_protocol.yaml::latency.strict_deadline_s * 1000)"},
    "deadline_miss": {"type": "boolean",
                      "description": "latency_total_ms > deadline_ms"}
  },
  "additionalProperties": false
}