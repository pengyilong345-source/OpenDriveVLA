{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendrivevla.local/schema/carla/sample_v1_1.schema.json",
  "title": "OpenDriveVLA CARLA synchronized sample v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "carla_version", "sample_id", "episode_id", "frame_id",
    "timestamp", "sample_valid", "scenario_type", "scenario_name", "town",
    "route_id", "weather", "event_types", "sensors", "calibration", "ego_state",
    "history_trajectory_ego_frame", "future_trajectory_ego_frame", "command",
    "actors", "map", "conventions"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "carla_version": {"const": "0.9.15"},
    "sample_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "number", "minimum": 0},
    "sample_valid": {"type": "boolean"},
    "scenario_type": {"type": "integer", "enum": [1, 2, 3]},
    "scenario_name": {"type": "string", "enum": ["basic_control", "complex_obstacle_avoidance", "extreme_emergency"]},
    "town": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "weather": {"type": "string", "minLength": 1},
    "event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sensors": {
      "type": "object", "additionalProperties": false,
      "required": ["front", "front_left", "front_right", "rear", "rear_left", "rear_right", "lidar"],
      "properties": {
        "front": {"$ref": "#/$defs/imageSensor"},
        "front_left": {"$ref": "#/$defs/imageSensor"},
        "front_right": {"$ref": "#/$defs/imageSensor"},
        "rear": {"$ref": "#/$defs/imageSensor"},
        "rear_left": {"$ref": "#/$defs/imageSensor"},
        "rear_right": {"$ref": "#/$defs/imageSensor"},
        "lidar": {"$ref": "#/$defs/lidarSensor"}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_intrinsics_path", "camera_extrinsics_path", "extrinsics_type"],
      "properties": {
        "camera_intrinsics_path": {"const": "calib/camera_intrinsics.json"},
        "camera_extrinsics_path": {"const": "calib/camera_extrinsics.json"},
        "extrinsics_type": {"const": "sensor_to_ego"}
      }
    },
    "ego_state": {"$ref": "#/$defs/egoState"},
    "history_trajectory_ego_frame": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/trajectoryPoint"}},
    "future_trajectory_ego_frame": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/trajectoryPoint"}},
    "command": {"$ref": "#/$defs/command"},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "map": {"type": "object"},
    "conventions": {"type": "object"}
  },
  "$defs": {
    "imageSensor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "frame_id", "timestamp"],
      "properties": {
        "path": {"type": "string", "pattern": "\\.jpg$"},
        "frame_id": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "number", "minimum": 0}
      }
    },
    "lidarSensor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "frame_id", "timestamp", "point_count", "storage_format", "dtype", "fields", "coordinate_frame"],
      "properties": {
        "path": {"type": "string", "pattern": "\\.(bin|laz)$"},
        "frame_id": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "number", "minimum": 0},
        "point_count": {"type": "integer", "minimum": 1},
        "storage_format": {"enum": ["bin_float32", "laz"]},
        "dtype": {"enum": ["float32", "scaled_integer"]},
        "fields": {
          "oneOf": [
            {"const": ["x", "y", "z", "intensity"]},
            {"const": ["x", "y", "z"]}
          ]
        },
        "coordinate_frame": {"const": "ego"}
      },
      "allOf": [
        {
          "if": {"properties": {"storage_format": {"const": "bin_float32"}}},
          "then": {"properties": {"path": {"pattern": "\\.bin$"}, "dtype": {"const": "float32"}, "fields": {"const": ["x", "y", "z", "intensity"]}}}
        },
        {
          "if": {"properties": {"storage_format": {"const": "laz"}}},
          "then": {"properties": {"path": {"pattern": "\\.laz$"}, "dtype": {"const": "scaled_integer"}, "fields": {"const": ["x", "y", "z"]}}}
        }
      ]
    },
    "trajectoryPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["dt", "x", "y"],
      "properties": {"dt": {"type": "number"}, "x": {"type": "number"}, "y": {"type": "number"}}
    },
    "egoState": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "z", "yaw", "speed", "acceleration", "yaw_rate", "steer", "throttle", "brake", "current_lane_id", "is_at_junction", "traffic_light_state"],
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"},
        "yaw": {"type": "number", "minimum": -3.141592654, "maximum": 3.141592654},
        "speed": {"type": "number", "minimum": 0}, "acceleration": {"type": "number"}, "yaw_rate": {"type": "number"},
        "steer": {"type": "number", "minimum": -1, "maximum": 1},
        "throttle": {"type": "number", "minimum": 0, "maximum": 1},
        "brake": {"type": "number", "minimum": 0, "maximum": 1},
        "current_lane_id": {"type": "string"}, "is_at_junction": {"type": "boolean"},
        "traffic_light_state": {"enum": ["red", "yellow", "green", "none"]}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["audio_path", "command_text", "normalized_command", "command_type", "command_source", "intent_label", "target_speed_mps", "target_lane"],
      "properties": {
        "audio_path": {"type": ["string", "null"]}, "command_text": {"type": "string"}, "normalized_command": {"type": "string"},
        "command_type": {"enum": ["single", "compound", "emergency", "ambiguous"]},
        "command_source": {"type": "string"}, "intent_label": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target_speed_mps": {"type": ["number", "null"], "minimum": 0}, "target_lane": {"type": ["string", "null"]}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "track_id", "class", "relative_x", "relative_y", "speed", "yaw", "bbox_3d", "is_relevant"],
      "properties": {
        "actor_id": {"type": "integer"}, "track_id": {"type": "integer"},
        "class": {"enum": ["vehicle", "pedestrian", "bicycle", "motorcycle", "traffic_cone", "static_obstacle"]},
        "relative_x": {"type": "number"}, "relative_y": {"type": "number"}, "speed": {"type": "number", "minimum": 0},
        "yaw": {"type": "number", "minimum": -3.141592654, "maximum": 3.141592654},
        "bbox_3d": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number"}},
        "is_relevant": {"type": "boolean"}
      }
    }
  }
}
